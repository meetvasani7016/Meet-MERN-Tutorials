{
  "name": "mern-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start-server": "npm run start --workspace=server",
    "start-client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run start-server\" \"npm run start-client\""
  }
}